# .gitlab-ci.yml

# =========================================================
# 🦊 GitLab CI/CD Pipeline
# ---------------------------------------------------------
# Equivalent architecture based on:
# - ci.yml
# - docker-dev.yml
# - docker-prod.yml
# - release.yml
#
# Responsibilities:
# - Validation / Testing
# - Development Docker image publishing
# - Production Docker image publishing
# - Release artifact generation
#
# Notes:
# - GitLab CI does not use separate workflow files like
#   GitHub Actions.
# - GitLab pipelines are usually centralized into a single
#   `.gitlab-ci.yml`.
# - This pipeline keeps the same architecture philosophy:
#   separation of responsibilities by stages/jobs.
# =========================================================

# =========================================================
# 🧩 STAGES
# =========================================================

stages:
  - validate
  - docker-dev
  - docker-prod
  - release

# =========================================================
# 🌍 GLOBAL VARIABLES
# =========================================================

variables:
  PIP_CACHE_DIR: "$CI_PROJECT_DIR/.cache/pip"

  DOCKER_DRIVER: overlay2
  DOCKER_TLS_CERTDIR: ""

  REGISTRY_IMAGE: "$CI_REGISTRY_IMAGE"

  GIT_DEPTH: 0

# =========================================================
# ⚡ CACHE
# =========================================================

cache:
  paths:
    - .cache/pip

# =========================================================
# 🧪 VALIDATION / CI
# ---------------------------------------------------------
# Equivalent to:
# - ci.yml
# - make check-ci
# =========================================================

validate:
  stage: validate

  parallel:
    matrix:
      - PYTHON_VERSION: ["3.11", "3.12", "3.13", "3.14"]

  image: python:${PYTHON_VERSION}

  before_script:
    - python --version
    - python -m pip install --upgrade pip
    - pip install -e .[dev]

  script:
    - make check-ci

  rules:
    - if: '$CI_PIPELINE_SOURCE == "push"'
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'

# =========================================================
# 🧪 CLI SMOKE TESTS
# =========================================================

cli:
  stage: validate

  image: python:3.14

  before_script:
    - python --version
    - pip install --upgrade pip
    - pip install -e .[dev]

  script:
    - path-header-scanner --help
    - path-header-scanner init --help
    - path-header-scanner scan --help

# =========================================================
# 🐋 DEVELOPMENT DOCKER IMAGE
# ---------------------------------------------------------
# Equivalent to:
# - docker-dev.yml
#
# Publishes:
# - :dev
# - :sha-<commit>
# =========================================================

build-dev-image:
  stage: docker-dev

  image: docker:28

  services:
    - docker:28-dind

  before_script:
    - docker info

    # Login to GitLab Container Registry
    - echo "$CI_REGISTRY_PASSWORD" | docker login -u "$CI_REGISTRY_USER" --password-stdin "$CI_REGISTRY"

  script:
    # Build development image
    - |
      docker build \
        --target development \
        -f Dockerfile \
        -t $REGISTRY_IMAGE:dev \
        -t $REGISTRY_IMAGE:sha-$CI_COMMIT_SHA \
        .

    # Push images
    - docker push $REGISTRY_IMAGE:dev
    - docker push $REGISTRY_IMAGE:sha-$CI_COMMIT_SHA

  rules:
    - if: '$CI_COMMIT_BRANCH == "develop"'
    - if: '$CI_COMMIT_BRANCH == "dev"'

# =========================================================
# 🐋 PRODUCTION DOCKER IMAGE
# ---------------------------------------------------------
# Equivalent to:
# - docker-prod.yml
#
# Publishes:
# - :latest
# - :v<version>
# - :sha-<commit>
# =========================================================

build-prod-image:
  stage: docker-prod

  image: docker:28

  services:
    - docker:28-dind

  before_script:
    - docker info

    # Login to GitLab Container Registry
    - echo "$CI_REGISTRY_PASSWORD" | docker login -u "$CI_REGISTRY_USER" --password-stdin "$CI_REGISTRY"

  script:
    # Build production image
    - |
      docker build \
        --target production \
        -f Dockerfile \
        -t $REGISTRY_IMAGE:latest \
        -t $REGISTRY_IMAGE:sha-$CI_COMMIT_SHA \
        .

    # Push latest + sha images
    - docker push $REGISTRY_IMAGE:latest
    - docker push $REGISTRY_IMAGE:sha-$CI_COMMIT_SHA

    # Push semantic version tag if pipeline triggered by tag
    - |
      if [ -n "$CI_COMMIT_TAG" ]; then
        docker tag $REGISTRY_IMAGE:latest $REGISTRY_IMAGE:$CI_COMMIT_TAG
        docker push $REGISTRY_IMAGE:$CI_COMMIT_TAG
      fi

  rules:
    - if: '$CI_COMMIT_BRANCH == "main"'
    - if: "$CI_COMMIT_TAG =~ /^v.*/"

# =========================================================
# 🚀 RELEASE
# ---------------------------------------------------------
# Equivalent to:
# - release.yml
#
# Responsibilities:
# - Validate release tags
# - Build package artifacts
# - Read annotated git tag message
# - Publish GitLab Release
# =========================================================

release:
  stage: release

  image: python:3.14

  before_script:
    - python --version
    - python -m pip install --upgrade pip
    - pip install build
    - git fetch --tags

  script:
    # =====================================================
    # 🏷️ VALIDATE RELEASE TAG
    # =====================================================

    - |
      TAG="$CI_COMMIT_TAG"

      echo "Tag: $TAG"

      REGEX='^v[0-9]+\.[0-9]+\.[0-9]+([.-](alpha|beta|rc|dev|post)\.[0-9]+)?(\+[0-9A-Za-z.]+)?$'

      if [[ ! "$TAG" =~ $REGEX ]]; then
        echo "❌ Invalid release tag format: $TAG"
        exit 1
      fi

      echo "✅ Release tag validated"

    # =====================================================
    # 📦 BUILD PACKAGE
    # =====================================================

    - python -m build

    # =====================================================
    # 📝 GENERATE RELEASE NOTES
    # =====================================================

    - |
      VERSION="${CI_COMMIT_TAG#v}"

      TYPE="stable"

      if [[ "$VERSION" == *alpha* ]]; then
        TYPE="alpha"
      elif [[ "$VERSION" == *beta* ]]; then
        TYPE="beta"
      elif [[ "$VERSION" == *rc* ]]; then
        TYPE="rc"
      elif [[ "$VERSION" == *dev* ]]; then
        TYPE="dev"
      elif [[ "$VERSION" == *post* ]]; then
        TYPE="post"
      fi

      # Extract annotated tag message
      git tag -l --format='%(contents)' "$CI_COMMIT_TAG" > RELEASE_NOTES.md

      cat <<EOF >> RELEASE_NOTES.md

      ---

      ## 📦 Release Information

      - Version: \`$VERSION\`
      - Release Type: \`$TYPE\`

      ## 🐋 Docker Image

      \`\`\`bash
      docker pull $REGISTRY_IMAGE:$CI_COMMIT_TAG
      \`\`\`

      ## 📥 Python Package

      Artifacts are attached to this release.

      EOF

  artifacts:
    paths:
      - dist/
      - RELEASE_NOTES.md

  release:
    tag_name: "$CI_COMMIT_TAG"
    name: "🚀 Release $CI_COMMIT_TAG"
    description: "./RELEASE_NOTES.md"

  rules:
    - if: "$CI_COMMIT_TAG =~ /^v.*/"
